---
import { STORE } from '../data/store';
interface Props {
  label: string;
  text: string;
}
const { label, text } = Astro.props;
const href = `${STORE.whatsapp}?text=${encodeURIComponent(text)}`;
---
<a class="wa-fab" href={href} target="_blank" rel="noopener" aria-label={label} data-cid="whatsapp-fab">
  <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M16.04 3C9.4 3 4 8.36 4 14.96c0 2.3.66 4.45 1.8 6.27L4 29l7.98-1.78a12.1 12.1 0 0 0 4.06.7C22.68 27.92 28 22.56 28 15.96S22.68 3 16.04 3Zm0 22.73c-1.3 0-2.58-.23-3.8-.68l-.27-.1-4.73 1.05 1.06-4.53-.18-.29a10.3 10.3 0 0 1-1.62-5.22c0-5.6 4.6-10.16 9.54-10.16 5.48 0 9.86 4.56 9.86 10.16s-4.38 9.77-9.86 9.77Zm5.5-7.42c-.3-.15-1.78-.87-2.05-.97-.28-.1-.48-.15-.68.15-.2.3-.78.97-.96 1.17-.18.2-.35.22-.65.07a8.1 8.1 0 0 1-2.39-1.47 9 9 0 0 1-1.66-2.06c-.17-.3 0-.46.13-.61.13-.13.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.62-.93-2.22-.24-.58-.49-.5-.68-.51h-.58c-.2 0-.53.07-.8.37-.28.3-1.05 1.02-1.05 2.5s1.08 2.9 1.23 3.1c.15.2 2.12 3.23 5.13 4.53.72.31 1.28.5 1.71.63.72.23 1.37.2 1.89.12.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.08-.13-.28-.2-.58-.35Z"/>
  </svg>
</a>

<style>
  .wa-fab {
    position: fixed;
    z-index: 60;
    inset-block-end: max(16px, env(safe-area-inset-bottom));
    inset-inline-end: 16px;
    display: grid;
    place-items: center;
    inline-size: 56px;
    block-size: 56px;
    border-radius: 50%;
    background: #1f7a4d;
    color: #fff;
    box-shadow: 0 10px 30px rgb(15 60 35 / 0.35);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .wa-fab:hover { transform: translateY(-3px) scale(1.04); }
  .wa-fab:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .wa-fab { transition: none; } }
</style>
