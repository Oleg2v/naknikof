---
/** Line icons for catalogue categories (48×48, stroke = currentColor). Decorative. */
interface Props {
  name: 'casings' | 'additives' | 'spices' | 'smoking' | 'sousvide' | 'equipment' | 'kits' | 'gift' | 'castiron' | 'thermo' | 'vacuum' | 'boards';
  class?: string;
}
const { name, class: cls = '' } = Astro.props;
---
<svg class={`caticon ${cls}`} viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'casings' && (
    <g>
      <ellipse cx="22" cy="24" rx="15" ry="9" />
      <ellipse cx="22" cy="24" rx="10" ry="5.5" />
      <ellipse cx="22" cy="24" rx="5" ry="2.4" />
      <path d="M37 24c2 0 4 1.5 5 4s-1 6-4 7" />
    </g>
  )}
  {name === 'additives' && (
    <g>
      <path d="M15 13h18v4l2 3v19a3 3 0 0 1-3 3H16a3 3 0 0 1-3-3V20l2-3z" />
      <path d="M15 17h18" />
      <path d="M19 33l10-10" />
      <circle cx="20" cy="24.5" r="1.6" />
      <circle cx="28" cy="31.5" r="1.6" />
      <path d="M17 9h14" />
    </g>
  )}
  {name === 'spices' && (
    <g>
      <path d="M10 36C10 22 20 11 38 10c0 17-11 27-25 27" />
      <path d="M10 38c6-8 12-14 20-20" />
      <circle cx="31" cy="34" r="2.6" />
      <circle cx="37.5" cy="30" r="2.2" />
      <circle cx="36" cy="38" r="2" />
    </g>
  )}
  {name === 'smoking' && (
    <g>
      <path d="M9 37l14-6 16 4-14 6z" />
      <path d="M9 37v3l16 5v-3" />
      <path d="M39 35v3l-14 7" />
      <path d="M20 26c-3-4 3-6 0-10s2-6 0-9" />
      <path d="M28 26c-3-4 3-6 0-10" />
    </g>
  )}
  {name === 'sousvide' && (
    <g>
      <path d="M9 18h30v18a5 5 0 0 1-5 5H14a5 5 0 0 1-5-5z" />
      <path d="M13 26c2.5 1.5 4.5 1.5 7 0s4.5-1.5 7 0 4.5 1.5 7 0" />
      <rect x="31" y="6" width="5" height="22" rx="2.5" />
      <path d="M17 31h9l2 6H15z" />
    </g>
  )}
  {name === 'equipment' && (
    <g>
      <rect x="15" y="14" width="13" height="24" rx="2" />
      <path d="M28 33h7l7 2v2l-7 1h-7" />
      <path d="M21.5 14V7M16 7h11" />
      <path d="M12 41h20" />
      <path d="M27 7h4v4" />
    </g>
  )}
  {name === 'kits' && (
    <g>
      <path d="M8 18l16-8 16 8v18l-16 8-16-8z" />
      <path d="M8 18l16 8 16-8M24 26v18" />
      <path d="M16 14l16 8" />
    </g>
  )}
  {name === 'gift' && (
    <g>
      <rect x="7" y="14" width="34" height="22" rx="3" />
      <path d="M7 22h34M18 14v22" />
      <path d="M18 14c-4-6 4-8 6-2 2-6 10-4 6 2" />
    </g>
  )}
  {name === 'castiron' && (
    <g>
      <ellipse cx="20" cy="26" rx="13" ry="8" />
      <path d="M7 26v3c0 4.5 5.8 8 13 8s13-3.5 13-8v-3" />
      <path d="M33 25l9-3" />
      <path d="M15 19c-1-3 1-4 0-7M21 18c-1-3 1-4 0-7" />
    </g>
  )}
  {name === 'thermo' && (
    <g>
      <circle cx="18" cy="18" r="10" />
      <path d="M18 18l4-4M18 10v2" />
      <path d="M25 25l15 15" />
    </g>
  )}
  {name === 'vacuum' && (
    <g>
      <path d="M12 8h24v32H12z" />
      <path d="M12 13h24" />
      <path d="M17 20h14M17 25h14M17 30h14M17 35h9" stroke-dasharray="1.5 3" />
    </g>
  )}
  {name === 'boards' && (
    <g>
      <rect x="6" y="16" width="30" height="22" rx="3" />
      <path d="M36 24h3a3 3 0 0 1 0 6h-3" />
      <path d="M14 10l22 4" />
      <path d="M12 9.5l3 .5" stroke-width="3.5" />
    </g>
  )}
</svg>
