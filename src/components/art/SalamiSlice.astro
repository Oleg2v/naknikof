---
/**
 * Procedural salami cross-section (build-time SVG, deterministic by seed).
 * Brand motif: hero, "slicing" chapter, placeholders. Pure vector, ~3–6 KB inline.
 */
interface Props {
  seed?: number;
  specks?: number;
  pepper?: number;
  class?: string;
  label?: string; // aria-label; omit → decorative
  tone?: 'raw' | 'cured';
}
const { seed = 7, specks = 46, pepper = 14, class: cls = '', label, tone = 'cured' } = Astro.props;

// mulberry32 PRNG
function rng(a: number) {
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = rng(seed);
const R = 100; // radius in viewBox units (viewBox -110..110)
const f = (n: number) => n.toFixed(1);

type Blob = { d: string };
const fat: Blob[] = [];
const placed: { x: number; y: number; s: number }[] = [];
let guard = 0;
while (fat.length < specks && guard++ < specks * 40) {
  const s = 3 + r() * 7.5; // size
  const ang = r() * Math.PI * 2;
  const dist = Math.sqrt(r()) * (R - 14 - s);
  const x = Math.cos(ang) * dist;
  const y = Math.sin(ang) * dist;
  if (placed.some((p) => Math.hypot(p.x - x, p.y - y) < p.s + s + 2.2)) continue;
  placed.push({ x, y, s });
  // irregular polygon (5–7 points)
  const n = 5 + Math.floor(r() * 3);
  const rot = r() * Math.PI * 2;
  const pts = Array.from({ length: n }, (_, i) => {
    const a = rot + (i / n) * Math.PI * 2;
    const rr = s * (0.62 + r() * 0.5);
    return [x + Math.cos(a) * rr, y + Math.sin(a) * rr * (0.75 + r() * 0.35)];
  });
  // smooth closed path through points (quadratic midpoints)
  const mid = (a: number[], b: number[]) => [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
  let d = '';
  for (let i = 0; i < n; i++) {
    const p0 = pts[i];
    const p1 = pts[(i + 1) % n];
    const m = mid(p0, p1);
    d += i === 0 ? `M${f(mid(pts[n - 1], p0)[0])} ${f(mid(pts[n - 1], p0)[1])}` : '';
    d += `Q${f(p0[0])} ${f(p0[1])} ${f(m[0])} ${f(m[1])}`;
  }
  fat.push({ d: d + 'Z' });
}
const peppers = Array.from({ length: pepper }, () => {
  const ang = r() * Math.PI * 2;
  const dist = Math.sqrt(r()) * (R - 16);
  return { x: Math.cos(ang) * dist, y: Math.sin(ang) * dist, s: 1.6 + r() * 1.6 };
});
const id = `ss${seed}`;
const meatA = tone === 'raw' ? '#d9737a' : '#b0283f';
const meatB = tone === 'raw' ? '#b84a56' : '#6e1634';
---
<svg
  class={`salami ${cls}`}
  viewBox="-110 -110 220 220"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <defs>
    <radialGradient id={`${id}m`} cx="0.42" cy="0.38" r="0.75">
      <stop offset="0" stop-color={meatA} />
      <stop offset="1" stop-color={meatB} />
    </radialGradient>
  </defs>
  <circle r="106" class="salami__casing" fill="#3a0f1b" />
  <circle r="101" class="salami__rim" fill="none" stroke="#e9d9c4" stroke-opacity=".35" stroke-width="1.2" />
  <circle r="99" class="salami__meat" fill={`url(#${id}m)`} />
  <g class="salami__fat" fill="#f4e6d3">
    {fat.map((b) => <path d={b.d} />)}
  </g>
  <g class="salami__pepper" fill="#1c0c0c">
    {peppers.map((p) => <circle cx={f(p.x)} cy={f(p.y)} r={f(p.s)} />)}
  </g>
</svg>
