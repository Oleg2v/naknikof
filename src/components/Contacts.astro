---
import { STORE, waLink } from '../data/store';
import type { Copy } from '../i18n/ru';
interface Props {
  t: Copy;
}
const { t } = Astro.props;
const lang = t.lang as 'ru' | 'he';
const c = t.contacts;
const tel = `tel:${STORE.phoneIntl.replace(/-/g, '')}`;
---
<section class="ct cv" id="contacts" data-cid="contacts" aria-labelledby="ct-title">
  <div class="wrap ct__grid">
    <div class="ct__head">
      <p class="eyebrow ct__eyebrow"><span class="dot" aria-hidden="true"></span>{c.eyebrow}</p>
      <h2 id="ct-title" class="ct__title" data-reveal>{c.title}</h2>
      <p class="ct__moved" data-reveal style="--rd:100ms">{c.moved}</p>
      <div class="ct__ctas">
        <a class="btn ct__wa" href={waLink(lang === 'he' ? 'שלום! יש לי שאלה' : 'Здравствуйте! У меня вопрос')} target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C9.4 3 4 8.36 4 14.96c0 2.3.66 4.45 1.8 6.27L4 29l7.98-1.78a12.1 12.1 0 0 0 4.06.7C22.68 27.92 28 22.56 28 15.96S22.68 3 16.04 3Z"/></svg>
          {c.whatsapp}
        </a>
        <a class="btn ct__call" href={tel}>{c.call}</a>
      </div>
      <p class="ct__reply">{c.reply}</p>
    </div>

    <dl class="ct__list">
      <div class="ct__row" data-cid="contact-address">
        <dt>{c.address}</dt>
        <dd>
          <p class="ct__big">{STORE.address.street[lang]}, {STORE.address.city[lang]}</p>
          <p class="ct__links">
            <a href={STORE.maps} target="_blank" rel="noopener">{c.maps} ↗</a>
            <a href={STORE.waze} target="_blank" rel="noopener">{c.waze} ↗</a>
          </p>
        </dd>
      </div>
      <div class="ct__row" data-cid="contact-phone">
        <dt>{c.phone}</dt>
        <dd><a class="ct__big" href={tel} dir="ltr">{STORE.phone}</a></dd>
      </div>
      <div class="ct__row">
        <dt>{c.email}</dt>
        <dd><a class="ct__big ct__mail" href={`mailto:${STORE.email}`} dir="ltr">{STORE.email}</a></dd>
      </div>
      <div class="ct__row">
        <dt>{c.hours}</dt>
        <dd><p class="ct__text">{c.hoursText}</p></dd>
      </div>
      <div class="ct__row">
        <dt>{c.telegram}</dt>
        <dd><a class="ct__text ct__tg" href={STORE.telegram} target="_blank" rel="noopener" dir="ltr">t.me/kolbassnik ↗</a></dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .ct { background: var(--smoke); color: var(--cream-on-dark); padding-block: var(--section); }
  .ct :global(.eyebrow) { color: #f0b49b; }
  .ct__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 40px clamp(12px, 1.6vw, 24px); }
  .ct__head { grid-column: 1 / span 5; display: grid; gap: 22px; align-content: start; }
  .ct__title { font: 700 var(--fs-h2) / var(--lh-display) var(--font-display); letter-spacing: var(--track-display); }
  .ct__moved { font: 400 italic 1.4rem/1.3 var(--font-display); color: var(--muted-on-dark); max-inline-size: 30ch; }
  .ct__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .ct__wa { --btn-bg: #1f7a4d; --btn-fg: #fff; --btn-fill: #155c39; }
  .ct__call { --btn-border: rgb(243 235 223 / 0.35); --btn-fg: var(--cream-on-dark); --btn-fill: var(--cream-on-dark); --btn-fg-hover: var(--smoke); }
  .ct__reply { font-size: var(--fs-small); color: var(--muted-on-dark); }
  .ct__list { grid-column: 7 / span 6; margin: 0; border-block-start: 1px solid rgb(243 235 223 / 0.2); }
  .ct__row { display: grid; grid-template-columns: 9rem 1fr; gap: 16px; padding-block: 22px; border-block-end: 1px solid rgb(243 235 223 / 0.2); }
  .ct__row dt { font-size: var(--fs-small); color: var(--muted-on-dark); padding-block-start: 0.5em; }
  .ct__row dd { margin: 0; display: grid; gap: 10px; }
  .ct__big { font: 700 clamp(1.5rem, 1.1rem + 1.4vw, 2.4rem) / 1.1 var(--font-display); text-decoration: none; justify-self: start; }
  a.ct__big:hover { color: #f0b49b; }
  .ct__mail { font-size: clamp(1.2rem, 1rem + 1vw, 1.9rem); word-break: break-all; }
  .ct__links { display: flex; gap: 18px; font-weight: 600; font-size: 0.95rem; }
  .ct__links a { text-decoration-color: rgb(243 235 223 / 0.4); }
  .ct__text { color: var(--cream-on-dark); max-inline-size: 46ch; }
  .ct__tg { font-weight: 600; justify-self: start; }
  @media (max-width: 1000px) {
    .ct__head, .ct__list { grid-column: 1 / -1; }
  }
  @media (max-width: 520px) {
    .ct__row { grid-template-columns: 1fr; gap: 6px; }
    .ct__row dt { padding: 0; }
  }
</style>
