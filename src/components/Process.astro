---
/**
 * Signature section: "От мяса до колбасы" — sticky scroll story (desktop, motion allowed)
 * or four static plates (mobile, no-JS, prefers-reduced-motion). Same text DOM in both modes.
 */
import ProcessStage from './art/ProcessStage.astro';
import { STAGE_PICKS, STAGE_LINKS } from '../data/catalog';
import type { Copy } from '../i18n/ru';

interface Props {
  t: Copy;
}
const { t } = Astro.props;
const lang = t.lang as 'ru' | 'he';
const chapters = t.process.chapters;
const stageKeys = ['casing', 'stuffing', 'smoking', 'slicing'] as const;
---
<section class="proc" id="process" data-cid="process" aria-labelledby="proc-title">
  <div class="wrap proc__head">
    <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{t.process.eyebrow}</p>
    <h2 id="proc-title" class="proc__title" data-reveal>{t.process.title}</h2>
    <p class="proc__anaphora" data-reveal style="--rd:100ms">{chapters.map((c) => c.word).join('. ')}.</p>
    <p class="proc__lead" data-reveal style="--rd:180ms">{t.process.lead}</p>
  </div>

  <div class="proc__scroll">
    <div class="proc__sticky">
      <div class="proc__stage" aria-hidden="true">
        <ProcessStage state="anim" label="" uid="anim" />
      </div>

      <ol class="proc__chapters" role="list">
        {chapters.map((c, i) => {
          const key = stageKeys[i];
          const pick = STAGE_PICKS[key];
          return (
            <li class="proc__ch" data-ch={i} data-cid={`process-${key}`}>
              <figure class="proc__plate">
                <ProcessStage state={i as 0 | 1 | 2 | 3} label={`${c.word}: ${c.title}`} uid={`p${i}`} />
              </figure>
              <div class="proc__txt">
                <p class="proc__num" aria-hidden="true">{t.process.numerals[i]}</p>
                <h3 class="proc__word">
                  <span class="sr-only">{t.process.numerals[i]}. </span>{c.word}
                </h3>
                <p class="proc__chTitle">{c.title}</p>
                <p class="proc__chText">{c.text}</p>
                <div class="proc__links">
                  <a class="link-arrow" href={STAGE_LINKS[key]}>
                    {c.cta}
                    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11L11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
                  </a>
                  <a class="proc__pick" href={pick.url}>{pick[lang]}</a>
                </div>
              </div>
            </li>
          );
        })}
      </ol>

      <nav class="proc__rail" aria-label={t.process.railLabel}>
        <ol role="list">
          {chapters.map((c, i) => (
            <li>
              <a href={`#process-ch-${i}`} data-go={i} aria-label={`${t.process.numerals[i]} — ${c.word}`}>
                <span class="proc__tick" aria-hidden="true">{t.process.numerals[i]}</span>
              </a>
            </li>
          ))}
        </ol>
        <span class="proc__bar" aria-hidden="true"><i></i></span>
      </nav>
    </div>
    {chapters.map((_, i) => <span class="proc__anchor" id={`process-ch-${i}`} style={`--i:${i}`} aria-hidden="true"></span>)}
  </div>
</section>

<style>
  .proc {
    --stage-bg: var(--paper);
    --stage-fg: var(--ink);
    --stage-muted: var(--ink-2);
    --stage-accent: var(--accent);
    position: relative;
    background: var(--stage-bg);
    color: var(--stage-fg);
    padding-block-start: var(--section);
  }
  .proc__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px clamp(12px, 1.6vw, 24px);
    margin-block-end: clamp(32px, 5vw, 64px);
  }
  .proc__head .eyebrow { grid-column: 1 / -1; }
  .proc__title {
    grid-column: 1 / span 9;
    font: 700 var(--fs-h2) / var(--lh-display) var(--font-display);
    letter-spacing: var(--track-display);
  }
  .proc__anaphora {
    grid-column: 1 / span 8;
    font: 400 italic clamp(1.5rem, 1rem + 2vw, 2.8rem) / 1.1 var(--font-display);
    color: var(--accent);
  }
  .proc__lead { grid-column: 9 / span 4; align-self: end; color: var(--ink-2); font-size: var(--fs-lead); line-height: 1.45; }

  /* ---------- plates (default) ---------- */
  .proc__stage, .proc__rail, .proc__anchor { display: none; }
  .proc__chapters { display: grid; gap: clamp(48px, 7vw, 96px); padding-block-end: var(--section); }
  .proc__ch {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 20px clamp(12px, 1.6vw, 24px);
    align-items: center;
    padding-inline: var(--gutter);
    max-inline-size: var(--max-w);
    margin-inline: auto;
    inline-size: 100%;
  }
  .proc__plate { grid-column: 1 / span 7; margin: 0; border-radius: var(--radius-lg); background: var(--paper-3); padding: clamp(8px, 2vw, 24px); }
  .proc__ch:nth-child(3) .proc__plate { background: var(--smoke); --stage-bg: var(--smoke); }
  .proc__txt { grid-column: 8 / span 5; }
  .proc__ch:nth-child(even) .proc__plate { grid-column: 6 / span 7; grid-row: 1; }
  .proc__ch:nth-child(even) .proc__txt { grid-column: 1 / span 5; grid-row: 1; }

  .proc__num { font: 500 0.9rem/1 var(--font-ui); letter-spacing: 0.14em; color: var(--stage-accent); margin-block-end: 10px; }
  :global([lang='he']) .proc__num { font: 700 1.6rem/1 var(--font-display); letter-spacing: 0; }
  .proc__word {
    font: 700 clamp(3rem, 1.6rem + 5.4vw, 7.6rem) / 0.9 var(--font-display);
    letter-spacing: var(--track-display);
    margin-block-end: 18px;
  }
  .proc__chTitle { font: 400 italic clamp(1.3rem, 1.05rem + 0.9vw, 1.9rem) / 1.15 var(--font-display); color: var(--stage-accent); margin-block-end: 12px; }
  :global(html:not(.motion-ok)) .proc__ch:nth-child(3) .proc__txt { --stage-accent: var(--accent); }
  .proc__chText { color: var(--stage-muted); max-inline-size: 44ch; font-size: 1.05rem; }
  .proc__links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; margin-block-start: 22px; }
  .proc__pick {
    font-size: var(--fs-small);
    font-weight: 600;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    text-decoration: none;
  }
  .proc__pick:hover { border-color: currentColor; }

  /* ---------- scrolly mode (desktop + motion; class set by JS) ---------- */
  :global(.motion-ok) .proc .proc__scroll { position: relative; block-size: 460svh; }
  :global(.motion-ok) .proc .proc__sticky {
    position: sticky;
    inset-block-start: 0;
    block-size: 100svh;
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 1.6vw, 24px);
    align-items: center;
    padding-inline: var(--gutter);
    max-inline-size: var(--max-w);
    margin-inline: auto;
  }
  :global(.motion-ok) .proc .proc__stage { display: block; grid-column: 1 / span 8; grid-row: 1; align-self: center; }
  :global(.motion-ok) .proc .proc__chapters { display: block; position: relative; grid-column: 9 / span 4; grid-row: 1; block-size: 70svh; padding: 0; container-type: inline-size; }
  /* size the huge chapter word from its column, not the viewport, so «Копчение» never clips */
  :global(.motion-ok) .proc .proc__word { font-size: min(7.6rem, 21cqi); }
  :global(.motion-ok) .proc .proc__ch { position: absolute; inset: 0; display: flex; align-items: center; padding: 0; opacity: 0; }
  :global(.motion-ok) .proc .proc__ch:first-child { opacity: 1; }
  :global(.motion-ok) .proc .proc__plate { display: none; }
  :global(.motion-ok) .proc .proc__txt { inline-size: 100%; }
  :global(.motion-ok) .proc .proc__rail {
    display: flex;
    position: absolute;
    inset-inline-end: var(--gutter);
    inset-block-end: calc(16px + 56px + 16px); /* above the WhatsApp button */
    align-items: center;
    gap: 16px;
  }
  :global(.motion-ok) .proc .proc__anchor { display: block; position: absolute; inset-inline: 0; block-size: 1px; inset-block-start: calc(var(--i) * 100svh + 30svh); }
  .proc__rail ol { display: flex; gap: 6px; }
  .proc__rail a {
    display: grid;
    place-items: center;
    inline-size: 40px;
    block-size: 40px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    text-decoration: none;
    font: 600 0.8rem/1 var(--font-ui);
    transition: background 0.3s, color 0.3s;
  }
  :global([lang='he']) .proc__rail a { font: 700 1rem/1 var(--font-display); }
  .proc__rail a.is-on { background: var(--accent); border-color: var(--accent); color: var(--paper); }
  .proc__bar { inline-size: 120px; block-size: 2px; background: color-mix(in srgb, currentColor 20%, transparent); overflow: hidden; }
  .proc__bar i { display: block; block-size: 100%; background: var(--ember); transform: scaleX(var(--p, 0)); transform-origin: var(--bar-origin, left); }
  :global([dir='rtl']) .proc__bar i { --bar-origin: right; }

  @media (max-width: 900px) {
    .proc__title, .proc__anaphora, .proc__lead { grid-column: 1 / -1; }
    .proc__ch { grid-template-columns: 1fr; }
    .proc__plate, .proc__txt, .proc__ch:nth-child(even) .proc__plate, .proc__ch:nth-child(even) .proc__txt { grid-column: 1; grid-row: auto; }
    .proc__word { font-size: clamp(2.6rem, 12vw, 4rem); }
  }
</style>
