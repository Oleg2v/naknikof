---
import { SALTS, MEAT } from '../lib/nitrite';
import { LINKS } from '../data/catalog';
import { STORE } from '../data/store';
import SalamiUse from './art/SalamiUse.astro';

const B = 'https://kolbassnik.com/blogs/%D0%BA%D0%BE%D0%BB%D0%B1%D0%B0%D1%81%D0%BD%D0%B8%D0%BA/';
const RECIPES = [
  B + '%D1%80%D0%B5%D1%86%D0%B5%D0%BF%D1%82%D1%8B-%D1%81-%D0%BD%D0%B8%D1%82%D1%80%D0%B8%D1%82%D0%BD%D0%BE%D0%B9-%D1%81%D0%BE%D0%BB%D1%8C%D1%8E-%D1%88%D0%B8%D0%BD%D0%BA%D0%B0-%D0%B2%D0%B5%D1%82%D1%87%D0%B8%D0%BD%D0%B0',
  B + '%D0%BA%D0%B0%D0%B1%D0%B0%D0%BD%D0%BE%D1%81%D1%8B',
  B + '%D0%BA%D1%83%D1%80%D0%B8%D0%BD%D1%8B%D0%B9-%D1%80%D1%83%D0%BB%D0%B5%D1%82-%D0%B8%D0%B7-%D0%B1%D0%B5%D0%B4%D1%80%D0%B0-%D1%80%D0%B5%D1%86%D0%B5%D0%BF%D1%82-%D1%81-%D0%BD%D0%B8%D1%82%D1%80%D0%B8%D1%82%D0%BD%D0%BE%D0%B9-%D1%81%D0%BE%D0%BB%D1%8C%D1%8E-0-6-%D0%B4%D1%83%D1%85%D0%BE%D0%B2%D0%BA%D0%B0-%D1%81%D1%83-%D0%B2%D0%B8%D0%B4',
  LINKS.salt2,
];
import type { Copy } from '../i18n/ru';

interface Props {
  t: Copy;
}
const { t } = Astro.props;
const lang = t.lang as 'ru' | 'he';
const c = t.calc;
const def = SALTS.n06;
const g0 = MEAT.def * def.def;
const fmt = (n: number, d = 0) => new Intl.NumberFormat(lang === 'ru' ? 'ru-RU' : 'he-IL', { maximumFractionDigits: d, minimumFractionDigits: d }).format(n);
---
<section class="calc section cv" id="calculator" data-cid="calculator" aria-labelledby="calc-title">
  <div class="wrap calc__grid">
    <div class="calc__intro">
      <p class="eyebrow calc__eyebrow"><span class="dot" aria-hidden="true"></span>{c.eyebrow}</p>
      <h2 id="calc-title" class="calc__title" data-reveal>{c.title}</h2>
      <p class="calc__lead" data-reveal style="--rd:100ms">{c.lead}</p>

      <details class="calc__more">
        <summary>{c.howTitle}</summary>
        <p>{c.how}</p>
        <ul role="list" class="calc__src">
          {c.sources.map((s) => <li>{s}</li>)}
        </ul>
        <p class="calc__recipes">
          {c.recipes}:{' '}
          {c.recipeLinks.map((label, i) => (
            <>
              <a href={RECIPES[i]} hreflang="ru">{label}</a>
              {i < c.recipeLinks.length - 1 && <span aria-hidden="true"> · </span>}
            </>
          ))}
        </p>
      </details>
      <div class="calc__safety" role="note" aria-labelledby="calc-safety">
        <p class="calc__safetyTitle" id="calc-safety">
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 1.8l7.4 13H1.6z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 7v3.6M9 12.6v.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          {c.safetyTitle}
        </p>
        <ul role="list">{c.safety.map((s) => <li>{s}</li>)}</ul>
      </div>
      <figure class="calc__cure" data-reveal>
        <SalamiUse seed={31} class="calc__slice" />
        <figcaption>{c.cureCaption}</figcaption>
      </figure>
    </div>

    <form class="calc__tool" data-calc data-lang={lang} aria-label={c.title} onsubmit="return false">
      <fieldset class="calc__seg">
        <legend class="calc__label">{c.product}</legend>
        <label><input type="radio" name="kind" value="n06" checked /><span>{c.n06Short}</span></label>
        <label><input type="radio" name="kind" value="n2" /><span>{c.n2Short}</span></label>
      </fieldset>
      <p class="calc__kindNote" data-kind-note aria-live="polite">{c.n06Note}</p>

      <div class="calc__field">
        <label class="calc__label" for="calc-meat">{c.meat}</label>
        <div class="calc__num">
          <button type="button" class="calc__step" data-step="-0.5" aria-label={c.less}>−</button>
          <input id="calc-meat" name="meat" type="text" inputmode="decimal" autocomplete="off" spellcheck="false" pattern="[0-9]+([.,][0-9]+)?" value={String(MEAT.def)} aria-describedby="calc-meat-unit" />
          <span class="calc__unit" id="calc-meat-unit">{c.kg}</span>
          <button type="button" class="calc__step" data-step="0.5" aria-label={c.more}>+</button>
        </div>
        <input class="calc__range" name="meatRange" type="range" min={MEAT.min} max={MEAT.max} step={MEAT.step} value={MEAT.def} aria-label={c.meat} />
        <div class="calc__chips" role="group" aria-label={c.presets}>
          {[1, 2.5, 5, 10].map((v) => <button type="button" class="calc__chip" data-kg={v}>{fmt(v, v % 1 ? 1 : 0)} {c.kg}</button>)}
        </div>
      </div>

      <div class="calc__field">
        <label class="calc__label" for="calc-rate">
          {c.level}: <output for="calc-rate" data-rate-out>{fmt(def.def, 1)}</output> {c.g}
        </label>
        <input id="calc-rate" class="calc__range" name="rate" type="range" min={def.min} max={def.max} step={def.step} value={def.def} />
        <div class="calc__scale" aria-hidden="true"><span data-rate-min>{fmt(def.min)} {c.g}</span><span data-rate-max>{fmt(def.max)} {c.g}</span></div>
      </div>

      <div class="calc__out" aria-live="polite" aria-atomic="true">
        <p class="calc__outLabel">{c.result}</p>
        <p class="calc__big"><output data-out-salt>{fmt(g0, 1)}</output><span>{c.g}</span></p>
        <dl class="calc__rows">
          <div><dt>{c.nitrite}</dt><dd><output data-out-nitrite>{fmt(g0 * def.nitrite * 1000)}</output> {c.mg} <small>(<span data-out-perkg>{fmt(def.def * def.nitrite * 1000)}</span> {c.mg} {c.perKg})</small></dd></div>
          <div data-nitrate-row hidden><dt>{c.nitrate}</dt><dd><output data-out-nitrate>0</output> {c.mg}</dd></div>
        </dl>
        <p class="calc__noSalt">{c.noTableSalt}</p>
      </div>

      <p class="calc__review">{c.reviewNote}</p>

      <div class="calc__buy">
        <a class="btn btn--light" href={LINKS.salt06} data-calc-buy>{c.buySalt}</a>
        <a class="btn calc__wa" data-calc-wa href={STORE.whatsapp} target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C9.4 3 4 8.36 4 14.96c0 2.3.66 4.45 1.8 6.27L4 29l7.98-1.78a12.1 12.1 0 0 0 4.06.7C22.68 27.92 28 22.56 28 15.96S22.68 3 16.04 3Z"/></svg>
          {c.waCta}
        </a>
        <a class="link-arrow calc__scaleLink" href={LINKS.scale}>
          {c.scale}
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11L11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </a>
      </div>
    </form>
  </div>
  <script type="application/json" id="calc-i18n" set:html={JSON.stringify({ n06: c.n06Note, n2: c.n2Note, g: c.g, wa: c.waText, n06Name: c.waName06, n2Name: c.waName2, phone: STORE.whatsapp, buy06: c.buySalt, buy2: c.buySalt2, href06: LINKS.salt06, href2: LINKS.salt2 })} />
</section>

<style>
  .calc {
    background: var(--accent);
    color: var(--paper);
    --line-c: rgb(243 235 223 / 0.22);
    overflow: clip;
  }
  .calc :global(.eyebrow) { color: var(--paper); }
  .calc__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 40px clamp(12px, 1.6vw, 24px); align-items: start; }
  .calc__intro { grid-column: 1 / span 5; display: grid; gap: 22px; }
  .calc__title { font: 700 var(--fs-h2) / var(--lh-display) var(--font-display); letter-spacing: var(--track-display); }
  .calc__lead { font-size: var(--fs-lead); line-height: 1.45; color: rgb(243 235 223 / 0.85); max-inline-size: 36ch; }
  .calc__more { border-block: 1px solid var(--line-c); padding-block: 14px; }
  .calc__more summary { cursor: pointer; font-weight: 600; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .calc__more summary::-webkit-details-marker { display: none; }
  .calc__more summary::after { content: '+'; font-size: 1.4rem; line-height: 1; transition: transform 0.3s var(--ease); }
  .calc__more[open] summary::after { transform: rotate(45deg); }
  .calc__more p { margin-block: 12px 10px; color: rgb(243 235 223 / 0.85); font-size: 0.95rem; }
  .calc__src { display: grid; gap: 6px; font-size: 0.85rem; color: rgb(243 235 223 / 0.75); }
  .calc__src li::before { content: '— '; }
  .calc__recipes { margin-block-start: 10px; font-size: 0.85rem; color: rgb(243 235 223 / 0.85); }
  .calc__recipes a { color: var(--paper); font-weight: 600; }
  .calc__cure { margin: 8px 0 0; display: flex; align-items: center; gap: 18px; }
  .calc__cure :global(.calc__slice) {
    inline-size: 96px;
    block-size: 96px;
    flex: none;
    filter: grayscale(0.85) brightness(1.25) sepia(0.2);
    transform: rotate(-30deg);
    transition: filter 2.2s var(--ease) 0.4s, transform 2.2s var(--ease) 0.4s;
  }
  .calc__cure.is-in :global(.calc__slice) { filter: none; transform: none; }
  .calc__cure figcaption { font: 400 italic 1.15rem/1.35 var(--font-display); color: rgb(243 235 223 / 0.92); max-inline-size: 30ch; }
  @media (prefers-reduced-motion: reduce) { .calc__cure :global(.calc__slice) { filter: none; transform: none; } }
  .calc__safety { background: rgb(0 0 0 / 0.18); border-radius: var(--radius); padding: 18px 20px; }
  .calc__safetyTitle { display: flex; align-items: center; gap: 8px; font-weight: 700; margin-block-end: 10px; color: #ffd9c7; }
  .calc__safety ul { display: grid; gap: 8px; font-size: 0.92rem; color: rgb(243 235 223 / 0.88); }
  .calc__safety li { padding-inline-start: 16px; position: relative; }
  .calc__safety li::before { content: ''; position: absolute; inset-inline-start: 0; inset-block-start: 0.6em; inline-size: 6px; block-size: 6px; border-radius: 50%; background: var(--ember); }

  .calc__tool {
    grid-column: 7 / span 6;
    background: var(--paper);
    color: var(--ink);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 3vw, 40px);
    display: grid;
    gap: 26px;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.5);
  }
  .calc__label { display: block; font-weight: 600; font-size: 0.95rem; margin-block-end: 10px; }
  .calc__seg { border: 0; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; background: var(--paper-2); border-radius: 14px; padding: 6px; }
  .calc__seg legend { grid-column: 1 / -1; padding: 0; }
  .calc__seg label { position: relative; }
  .calc__seg input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .calc__seg span { display: grid; place-items: center; min-block-size: 46px; border-radius: 10px; font-weight: 600; text-align: center; padding: 6px 10px; transition: background 0.25s, color 0.25s; }
  .calc__seg input:checked + span { background: var(--ink); color: var(--paper); }
  .calc__seg input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .calc__kindNote { font-size: 0.88rem; color: var(--ink-2); margin-block-start: -14px; }

  .calc__num { display: flex; align-items: center; gap: 10px; }
  .calc__num input {
    inline-size: 6.5ch;
    font: 700 2.6rem/1 var(--font-display);
    border: 0;
    border-block-end: 2px solid var(--ink);
    background: transparent;
    padding: 4px 0;
    text-align: center;
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .calc__num input::-webkit-outer-spin-button, .calc__num input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .calc__unit { font-weight: 600; color: var(--ink-2); }
  .calc__step { inline-size: 44px; block-size: 44px; border-radius: 50%; border: 1.5px solid var(--line-strong); background: transparent; font-size: 1.4rem; line-height: 1; }
  .calc__step:hover { background: var(--ink); color: var(--paper); }
  .calc__num .calc__step:last-child { margin-inline-start: auto; }

  .calc__range { inline-size: 100%; margin-block: 14px 8px; accent-color: var(--accent); block-size: 28px; }
  .calc__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .calc__chip { border: 1px solid var(--line-strong); background: transparent; border-radius: 999px; padding: 8px 14px; min-block-size: 40px; font-weight: 500; }
  .calc__chip:hover, .calc__chip.is-on { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .calc__scale { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--ink-2); }

  .calc__out { border-block-start: 1px solid var(--line-strong); padding-block-start: 22px; }
  .calc__outLabel { font-weight: 600; color: var(--ink-2); }
  .calc__big { display: flex; align-items: baseline; gap: 10px; font: 700 clamp(4rem, 2.6rem + 5vw, 7.4rem) / 0.95 var(--font-display); color: var(--accent); font-variant-numeric: tabular-nums; }
  .calc__big span { font: 600 1.6rem/1 var(--font-ui); color: var(--ink); }
  .calc__rows { display: grid; gap: 8px; margin-block-start: 12px; }
  .calc__rows div { display: flex; justify-content: space-between; gap: 16px; border-block-end: 1px dashed var(--line); padding-block-end: 8px; }
  .calc__rows dt { color: var(--ink-2); }
  .calc__rows dd { margin: 0; font-weight: 600; text-align: end; }
  .calc__rows small { font-weight: 400; color: var(--ink-2); }
  .calc__noSalt { margin-block-start: 12px; font-size: 0.9rem; color: var(--ink-2); }
  .calc__review {
    font-size: 0.82rem;
    padding: 8px 12px;
    border: 1px dashed color-mix(in srgb, var(--accent) 55%, transparent);
    border-radius: 10px;
    color: var(--accent);
  }
  .calc__buy { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; }
  .calc__buy .btn--light { --btn-bg: var(--ink); --btn-fg: var(--paper); --btn-fill: var(--accent); }
  .calc__wa { --btn-bg: #1f7a4d; --btn-fg: #fff; --btn-fill: #155c39; }
  .calc__scaleLink { flex-basis: 100%; justify-self: start; inline-size: fit-content; }

  @media (max-width: 1000px) {
    .calc__intro, .calc__tool { grid-column: 1 / -1; }
    .calc__tool { grid-row: 2; }
    .calc__intro .calc__more, .calc__intro .calc__safety { grid-row: auto; }
  }
</style>
