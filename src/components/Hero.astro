---
import SalamiSlice from './art/SalamiSlice.astro';
import { STORE } from '../data/store';
import type { Copy } from '../i18n/ru';

interface Props {
  t: Copy;
}
const { t } = Astro.props;
---
<section class="hero" id="top" data-cid="hero" aria-labelledby="hero-title">
  <div class="hero__inner wrap">
    <p class="hero__eyebrow eyebrow" data-cid="hero-eyebrow">
      <span class="dot" aria-hidden="true"></span>{t.hero.eyebrow}
    </p>

    <h1 class="hero__title" id="hero-title" data-cid="hero-title">
      {t.hero.h1.map((line, i) => (
        <span class={`hero__line hero__line--${i}`}>
          <span class="hero__lineIn" style={`--d:${i * 90}ms`}>{line}</span>
          {i === t.hero.h1.length - 1 && <span class="hero__lineIn hero__tail" style="--d:320ms"> {t.hero.h1Tail}</span>}
        </span>
      ))}
    </h1>

    <div class="hero__art" aria-hidden="true" data-cid="hero-art">
      <div class="hero__slice" data-hero-slice>
        <SalamiSlice seed={11} specks={150} pepper={22} />
      </div>
      <svg class="hero__orbit" viewBox="0 0 400 400" data-hero-orbit>
        <defs><path id="orbit" d="M200 200m-186 0a186 186 0 1 1 372 0a186 186 0 1 1-372 0" /></defs>
        <text><textPath href="#orbit">{t.process.chapters.map((c) => c.word).join('  ·  ')}  ·  {t.process.chapters.map((c) => c.word).join('  ·  ')}  ·</textPath></text>
      </svg>
    </div>

    <div class="hero__foot">
      <p class="hero__lead" data-cid="hero-lead">{t.hero.lead}</p>
      <div class="hero__ctas">
        <a class="btn btn--solid" href="#catalog" data-cursor="↓">{t.hero.ctaPrimary}</a>
        <a class="btn btn--ghost" href="#seminars">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <dl class="hero__stats" data-cid="hero-stats">
      {t.hero.stats.map((s) => (
        <div class="hero__stat">
          <dt class="sr-only">{s.label}</dt>
          <dd>
            <span class="hero__statValue" dir="ltr">{s.value}</span>
            <span class="hero__statLabel" aria-hidden="true">{s.label}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
  <a class="hero__scroll" href="#seminars" aria-label={t.hero.scroll}>
    <span aria-hidden="true">{t.hero.scroll}</span>
    <svg width="12" height="34" viewBox="0 0 12 34" aria-hidden="true"><path d="M6 0v32M1 27l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
  </a>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(28px, 5vw, 72px) clamp(56px, 7vw, 110px);
    overflow: clip;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(12px, 1.6vw, 24px);
    row-gap: clamp(20px, 3vw, 40px);
  }
  .hero__eyebrow { grid-column: 1 / -1; }
  .hero__title {
    grid-column: 1 / span 10;
    position: relative;
    z-index: 2;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-hero);
    line-height: var(--lh-display);
    letter-spacing: var(--track-display);
    color: var(--ink);
  }
  .hero__line { display: block; overflow: clip; padding-block: 0.04em 0.08em; margin-block: -0.04em -0.08em; }
  .hero__line--1 { padding-inline-start: 1.15em; }
  .hero__line--2 { color: var(--accent); }
  .hero__tail {
    font-weight: 400;
    font-style: italic;
    font-size: 0.36em;
    letter-spacing: 0;
    margin-inline-start: 0.2em;
    color: var(--ink-2);
    vertical-align: baseline;
  }
  .hero__lineIn {
    display: inline-block;
    animation: lineIn 1.05s var(--ease) backwards;
    animation-delay: var(--d, 0ms);
  }
  @keyframes lineIn {
    from { transform: translate3d(0, 105%, 0) rotate(2deg); }
  }

  .hero__art {
    position: absolute;
    inset-block-start: clamp(10px, 2.5vw, 40px);
    inset-inline-end: calc(var(--gutter) * -1 - 8vw);
    inline-size: clamp(300px, 39vw, 680px);
    aspect-ratio: 1;
    z-index: 1;
    pointer-events: none;
  }
  .hero__slice {
    position: absolute;
    inset: 9%;
    animation: sliceIn 1.6s var(--ease) backwards 0.15s;
    filter: drop-shadow(0 40px 60px rgb(60 10 20 / 0.28));
  }
  .hero__slice :global(svg) { inline-size: 100%; block-size: 100%; }
  @keyframes sliceIn {
    from { transform: translate3d(12%, 6%, 0) rotate(-40deg) scale(0.82); }
  }
  .hero__orbit {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    font: 500 13px/1 var(--font-ui);
    letter-spacing: 0.32em;
    text-transform: uppercase;
    fill: var(--ink-2);
    animation: orbitIn 1.4s var(--ease) backwards 0.5s;
  }
  :global([lang='he']) .hero__orbit { letter-spacing: 0.08em; font-size: 14px; }
  @keyframes orbitIn { from { opacity: 0; transform: rotate(-30deg); } }

  .hero__foot {
    grid-column: 1 / span 7;
    position: relative;
    z-index: 2;
    display: grid;
    gap: 28px;
    margin-block-start: clamp(8px, 2vw, 24px);
    animation: fadeUp 1s var(--ease) backwards 0.45s;
  }
  .hero__lead {
    max-inline-size: 36ch;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(18px); } }

  .hero__stats {
    grid-column: 1 / -1;
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(24px, 5vw, 64px) 0 0;
    border-block-start: 1px solid var(--line-strong);
    animation: fadeUp 1s var(--ease) backwards 0.6s;
  }
  .hero__stat { padding-block: 18px 4px; padding-inline-end: 16px; }
  .hero__stat + .hero__stat { padding-inline-start: clamp(12px, 2vw, 28px); border-inline-start: 1px solid var(--line); }
  .hero__stat dd { margin: 0; display: grid; gap: 6px; }
  .hero__statValue {
    font: 700 clamp(2rem, 1.2rem + 2.6vw, 3.6rem) / 1 var(--font-display);
    color: var(--accent);
    unicode-bidi: isolate;
    justify-self: start;
  }
  .hero__statLabel { font-size: var(--fs-small); color: var(--ink-2); max-inline-size: 22ch; }

  .hero__scroll {
    position: absolute;
    inset-block-end: 18px;
    inset-inline-end: var(--gutter);
    display: none;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    writing-mode: vertical-rl;
  }
  .hero__scroll svg { animation: nudge 2.4s var(--ease-io) infinite; }
  @keyframes nudge { 50% { transform: translateY(6px); } }

  @media (min-width: 1100px) {
    .hero__scroll { display: inline-flex; }
  }
  @media (max-width: 820px) {
    .hero__title { grid-column: 1 / -1; }
    .hero__foot { grid-column: 1 / -1; }
    .hero__art {
      position: relative;
      grid-column: 1 / -1;
      grid-row: 3;
      inset: auto;
      inline-size: min(86vw, 420px);
      justify-self: end;
      margin-block: -4vw -2vw;
      margin-inline-end: -16vw;
    }
    .hero__line--1 { padding-inline-start: 0.6em; }
  }
  @media (max-width: 520px) {
    .hero__stats { grid-template-columns: 1fr; }
    .hero__stat + .hero__stat { padding-inline-start: 0; border-inline-start: 0; border-block-start: 1px solid var(--line); }
    .hero__stat { display: flex; padding-block: 14px; }
    .hero__stat dd { grid-template-columns: auto 1fr; align-items: center; gap: 14px; }
    .hero__statValue { min-inline-size: 3.4ch; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__lineIn, .hero__slice, .hero__orbit, .hero__foot, .hero__stats, .hero__scroll svg { animation: none; }
  }
</style>
