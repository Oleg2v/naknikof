---
import type { Copy } from '../i18n/ru';
interface Props {
  t: Copy;
}
const { t } = Astro.props;
const icons: Record<string, string> = {
  free: '<path d="M4 15V8a2 2 0 0 1 2-2h12v9M18 10h5l3 4v5h-8M4 19h2m6 0h6"/><circle cx="9" cy="21" r="2.4"/><circle cx="22" cy="21" r="2.4"/>',
  door: '<path d="M8 27V5h14v22M5 27h20"/><circle cx="18" cy="16" r="1.2" fill="currentColor"/>',
  return: '<path d="M9 9H20a6 6 0 0 1 0 12h-9"/><path d="M13 5L9 9l4 4"/>',
  support: '<path d="M16 4C9.4 4 4 8.7 4 14.5c0 3 1.4 5.6 3.7 7.5L6.5 27l5.3-2.6c1.3.4 2.7.6 4.2.6 6.6 0 12-4.7 12-10.5S22.6 4 16 4z"/><path d="M11 13h10M11 17h6"/>',
  pay: '<rect x="5" y="13" width="22" height="14" rx="3"/><path d="M10 13V9a6 6 0 0 1 12 0v4"/><circle cx="16" cy="20" r="1.8"/>',
};
---
<section class="trust cv" id="delivery" data-cid="delivery" aria-labelledby="trust-title">
  <div class="wrap">
    <div class="trust__head">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{t.trust.eyebrow}</p>
      <h2 id="trust-title" class="trust__title" data-reveal>{t.trust.title}</h2>
    </div>
    <ul class="trust__list" role="list">
      {t.trust.items.map((it, i) => (
        <li class="trust__item" data-reveal style={`--rd:${i * 70}ms`} data-cid={`trust-${it.key}`}>
          <svg class="trust__icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[it.key]} />
          <h3 class="trust__itemTitle">{it.title}</h3>
          <p class="trust__text">{it.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust { background: var(--paper-2); padding-block: clamp(72px, 9vw, 140px); }
  .trust__head { display: grid; gap: 14px; margin-block-end: clamp(32px, 4vw, 56px); }
  .trust__title { font: 700 var(--fs-h2) / var(--lh-display) var(--font-display); letter-spacing: var(--track-display); max-inline-size: 14ch; }
  .trust__list { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; border-block-start: 1px solid var(--line-strong); }
  .trust__item { padding: 26px clamp(10px, 1.6vw, 24px) 10px 0; display: grid; gap: 10px; align-content: start; }
  .trust__item + .trust__item { padding-inline-start: clamp(14px, 1.6vw, 24px); border-inline-start: 1px solid var(--line); }
  .trust__icon { inline-size: 36px; block-size: 36px; color: var(--accent); }
  .trust__itemTitle { font: 700 1.3rem/1.1 var(--font-display); }
  .trust__text { font-size: 0.95rem; color: var(--ink-2); }
  @media (max-width: 1000px) {
    .trust__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .trust__item:nth-child(odd) { padding-inline-start: 0; border-inline-start: 0; }
    .trust__item { border-block-end: 1px solid var(--line); padding-block-end: 22px; }
  }
  @media (max-width: 560px) {
    .trust__list { grid-template-columns: 1fr; }
    .trust__item, .trust__item + .trust__item { padding-inline: 0; border-inline-start: 0; }
  }
</style>
