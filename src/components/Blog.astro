---
import { POSTS } from '../data/blog';
import { STORE } from '../data/store';
import { formatDay } from '../lib/format';
import type { Copy } from '../i18n/ru';

interface Props {
  t: Copy;
}
const { t } = Astro.props;
const lang = t.lang as 'ru' | 'he';
---
<section class="blog section cv" id="blog" data-cid="blog" aria-labelledby="blog-title">
  <div class="wrap">
    <header class="shead">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span>{t.blog.eyebrow}</p>
      <h2 id="blog-title" data-reveal>{t.blog.title}</h2>
      <p data-reveal style="--rd:120ms">{t.blog.lead}</p>
    </header>

    <ol class="blog__list" role="list">
      {POSTS.map((p, i) => (
        <li class={`post post--${i}`} data-reveal style={`--rd:${i * 110}ms`} data-cid={`post-${p.slug}`}>
          <a class="post__link" href={p.url} hreflang="ru" data-cursor={t.blog.read}>
            <p class="post__meta">
              <span class="post__tag">{p.tag[lang]}</span>
              <time datetime={p.date}>{formatDay(p.date, lang, true)}</time>
            </p>
            <h3 class="post__title">{p.title[lang]}</h3>
            {p.quote ? (
              <blockquote class="post__quote"><p>«{p.quote[lang]}»</p></blockquote>
            ) : (
              <p class="post__excerpt post__excerpt--lg">{p.excerpt[lang]}</p>
            )}
            {p.quote && <p class="post__excerpt">{p.excerpt[lang]}</p>}
            <p class="post__foot">
              <span class="post__by">{t.blog.by}</span>
              <span class="post__read">
                {t.blog.read}
                {lang === 'he' && <span class="post__ru">· {t.blog.inRussian}</span>}
                <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11L11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              </span>
            </p>
          </a>
        </li>
      ))}
    </ol>
    <a class="btn btn--ghost blog__all" href={STORE.links.blog} hreflang="ru">
      {t.blog.all}
      <svg class="arr" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
    </a>
  </div>
</section>

<style>
  .blog { background: var(--paper-3); }
  .blog__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--line-strong); }
  .post + .post { border-inline-start: 1px solid var(--line-strong); }
  .post__link {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: 18px;
    block-size: 100%;
    padding: clamp(22px, 2.6vw, 40px);
    text-decoration: none;
    position: relative;
    isolation: isolate;
  }
  .post__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--paper-2);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .post__link:hover::before { opacity: 1; }
  .post__meta { display: flex; justify-content: space-between; gap: 12px; font-size: var(--fs-small); color: var(--ink-2); }
  .post__tag { font-weight: 600; color: var(--accent); }
  .post__title {
    font: 700 clamp(1.5rem, 1.1rem + 1.2vw, 2.2rem) / 1.06 var(--font-display);
    letter-spacing: var(--track-display);
    background: linear-gradient(currentColor, currentColor) no-repeat var(--ul-pos, 0) 100% / 0 2px;
    transition: background-size 0.6s var(--ease);
    justify-self: start;
    padding-block-end: 4px;
  }
  :global([dir='rtl']) .post__title { --ul-pos: 100%; }
  .post__link:hover .post__title { background-size: 100% 2px; }
  .post__quote { margin: 0; }
  .post__quote p {
    font: 400 italic clamp(1.25rem, 1rem + 0.8vw, 1.7rem) / 1.25 var(--font-display);
    color: var(--accent);
  }
  .post__excerpt { color: var(--ink-2); font-size: 0.98rem; }
  .post__excerpt--lg { font: 400 italic clamp(1.15rem, 0.95rem + 0.6vw, 1.45rem) / 1.35 var(--font-display); color: var(--ink); }
  .post__foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding-block-start: 14px; border-block-start: 1px solid var(--line); font-size: var(--fs-small); }
  .post__by { color: var(--ink-2); }
  .post__read { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
  .post__ru { font-weight: 400; color: var(--ink-2); }
  :global([dir='rtl']) .post__read svg { transform: scaleX(-1); }
  .blog__all { margin-block-start: 32px; }

  @media (max-width: 1000px) {
    .blog__list { grid-template-columns: 1fr; }
    .post + .post { border-inline-start: 0; border-block-start: 1px solid var(--line-strong); }
    .post__link { padding-inline: 0; }
    .post__link::before { inset-inline: calc(var(--gutter) * -1); }
  }
</style>
