---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import Seo from '../components/Seo.astro';
import type { Copy } from '../i18n/ru';

interface Props {
  t: Copy;
}
const { t } = Astro.props;
const lang = t.lang as 'ru' | 'he';
const preload =
  lang === 'he'
    ? ['/fonts/bonanova-700-hebrew.woff2', '/fonts/rubik-hebrew.woff2']
    : ['/fonts/bonanova-700-cyrillic.woff2', '/fonts/rubik-cyrillic.woff2'];
// Demo lives on a kikkey.com subdomain: keep it out of search results so it never competes with kolbassnik.com.
const noindex = import.meta.env.PUBLIC_INDEXABLE !== 'true';
---
<!doctype html>
<html lang={lang} dir={t.dir} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3ebdf" />
    <meta name="format-detection" content="telephone=no" />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    {preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <Seo lang={lang} title={t.meta.title} description={t.meta.description} ogImage={`/og/og-${lang}.jpg`} ogAlt={t.meta.ogAlt} noindex={noindex} />
    <link rel="icon" href="/icons/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <slot />
  </body>
</html>
